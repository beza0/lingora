# Lingora ortam değişkenleri örneği. Gerçek değerleri .env dosyasına yaz; .env git'e eklenmez.

# --- Mobil uygulama (apps/mobile/.env.json olarak da verilebilir: flutter run --dart-define-from-file=.env.json)
SUPABASE_URL=
SUPABASE_ANON_KEY=
GOOGLE_IOS_CLIENT_ID=
GOOGLE_WEB_CLIENT_ID=
FEATURE_APPLE_SIGN_IN=false

# --- Yönetim paneli (apps/admin/.env)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# --- Yalnız yerel içerik yükleme komutu (content:seed). Asla uygulamaya veya panele girmez.
SUPABASE_SERVICE_ROLE_KEY=

# --- Edge Functions: Supabase Secrets ile ayarlanır (supabase secrets set AD=değer).
# Gizli: ANTHROPIC_API_KEY
# Gizli değil (varsayılanlar):
# AI_PROVIDER=anthropic
# AI_MODEL_CHAT=claude-haiku-5-5
# AI_MODEL_EVAL=claude-haiku-5-5
# AI_DAILY_CHAT_GUEST=3
# AI_DAILY_CHAT_USER=20
# AI_DAILY_EVAL_GUEST=10
# AI_DAILY_EVAL_USER=50
# AI_MAX_INPUT_CHARS=1000
# AI_MAX_OUTPUT_TOKENS=600
# AI_RATE_PER_MINUTE=6
# ANON_SIGNUPS_PER_IP_PER_DAY=5
